# CoFlow 生产环境配置
# 由 deploy/setup.sh 生成，数据库密码会替换 __DB_PASS__

DATABASE_URL="postgresql://coflow:__DB_PASS__@127.0.0.1:5432/coflow?schema=public"

NODE_ENV=production

# 用「公网 IP + HTTP」访问时设为 0，否则浏览器不会保存登录 Cookie。
# 注意：HTTP 下 Cookie 明文传输，只适合先跑通；配好域名和 HTTPS 后改成 1 或删掉。
COOKIE_SECURE=0

# 没有 SMTP 时的临时方案：验证码只写到服务端日志，不会出现在网页上。
# 登录时在服务器执行：journalctl -u coflow -n 200 | grep 验证码
# 配好下面的 SMTP 之后，删掉这一行。
LOGIN_CODE_TO_LOG=1

# 登录验证码邮件（配好后删掉上面的 LOGIN_CODE_TO_LOG）
# QQ 邮箱：smtp.qq.com / 465；163：smtp.163.com / 465
# SMTP_PASS 填邮箱的“授权码”，不是登录密码
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=your@qq.com
# SMTP_PASS=授权码
# SMTP_FROM=your@qq.com
