# CoFlow 本地开发连接串
# 建议为本项目单独建库与专用账号，不要复用其他项目的超级用户。
DATABASE_URL="postgresql://coflow:CHANGE_ME@127.0.0.1:5432/coflow?schema=public"

# 登录验证码邮件（可选）
# 不配置时：开发环境把验证码直接显示在登录页；生产环境登录会报错，不会静默失败。
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=you@example.com
# SMTP_PASS=your-smtp-authorization-code
# SMTP_FROM=you@example.com

# 生产环境如需临时显示验证码，显式打开（不建议）
# SHOW_DEV_CODE=0
